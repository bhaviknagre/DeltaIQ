# Copy to .env and fill in. Never commit the real .env file.

# --- LLM provider ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0

# --- Delta alignment thresholds ---
FUZZY_MATCH_THRESHOLD=78
SPATIAL_MATCH_MAX_DIST=60
MODIFIED_TEXT_THRESHOLD=99.5

# --- Retrieval ---
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.05
RETRIEVAL_BACKEND=bm25
HYBRID_BM25_WEIGHT=0.5

# --- Chat pipeline ---
# simple (default): one retrieve -> LLM -> parse-citations round trip.
# agentic: LangGraph retrieve -> answer -> verify-citations -> retry pipeline.
CHAT_BACKEND=simple
AGENTIC_MAX_RETRIES=2

# --- Embeddings ---
EMBEDDER=hashing
HASHING_EMBEDDER_DIM=256

# --- Vector store ---
VECTOR_STORE=chroma
CHROMA_HOST=
CHROMA_PORT=8100

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=delta-chat

# --- Metadata store: PID registry, canonical docs, delta results, chat
METADATA_STORE=json
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=delta_chat

# --- Blob store: raw PDFs, scanned images, OCR artifacts, markup outputs. ---
BLOB_STORE=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=delta-chat
MINIO_SECURE=false

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=admin

# --- Background tasks (Celery + Redis) ---
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# --- LLM observability (Langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- OCR ---
OCR_DPI=300
OCR_LANG=eng
OCR_PSM=11
