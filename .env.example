# Copy to .env and fill in. Never commit the real .env file.

# --- LLM provider ---
# anthropic | openai | groq | mock (mock requires no key; used automatically if no key is set)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Groq: free developer tier, no credit card required — console.groq.com/keys.
# OpenAI-compatible API, reuses OpenAIProvider under the hood (see chat/llm.py).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0

# --- Delta alignment thresholds ---
FUZZY_MATCH_THRESHOLD=78
SPATIAL_MATCH_MAX_DIST=60
MODIFIED_TEXT_THRESHOLD=99.5

# --- Retrieval ---
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.05

# --- OCR ---
OCR_DPI=300
OCR_LANG=eng
OCR_PSM=11
