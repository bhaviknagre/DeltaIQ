# Copy to .env and fill in. Never commit the real .env file.

# --- LLM provider ---
# anthropic | openai | groq | mock (mock requires no key; used automatically if no key is set)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Groq: free developer tier, no credit card required — console.groq.com/keys.
# OpenAI-compatible API, reuses OpenAIProvider under the hood (see chat/llm.py).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0

# --- Delta alignment thresholds ---
FUZZY_MATCH_THRESHOLD=78
SPATIAL_MATCH_MAX_DIST=60
MODIFIED_TEXT_THRESHOLD=99.5

# --- Retrieval ---
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.05
# bm25 (lexical, default, zero infra) | vector (Chroma/Pinecone) | hybrid (both, blended)
RETRIEVAL_BACKEND=bm25
HYBRID_BM25_WEIGHT=0.5

# --- Embeddings (only used if RETRIEVAL_BACKEND != bm25) ---
EMBEDDER=hashing
HASHING_EMBEDDER_DIM=256

# --- Vector store (only used if RETRIEVAL_BACKEND != bm25) ---
VECTOR_STORE=chroma
CHROMA_HOST=
CHROMA_PORT=8100
# Pinecone: production vector DB option. console.pinecone.io — needs a key.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=delta-chat

# --- Metadata store: PID registry, canonical docs, delta results, chat
# sessions, processing jobs, eval runs. json = zero infra (default). ---
METADATA_STORE=json
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=delta_chat

# --- Blob store: raw PDFs, scanned images, OCR artifacts, markup outputs. ---
BLOB_STORE=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=delta-chat
MINIO_SECURE=false

# --- Background tasks (Celery + Redis) ---
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# --- LLM observability (Langfuse). No-op if unset — see chat/answer.py. ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- OCR ---
OCR_DPI=300
OCR_LANG=eng
OCR_PSM=11
