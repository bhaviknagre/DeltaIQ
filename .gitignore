.venv/
__pycache__/
*.pyc
.env
logs/*.jsonl
traces/*.json
eval/results/*.json
# latest_metrics.json is a DVC metric (dvc.yaml, cache: false) — plain git-
# tracked on purpose so `dvc metrics diff`/`git diff` show score changes
# across commits; the timestamped per-run files above stay ignored.
!eval/results/latest_metrics.json
output/
data/renders/
data/pid_store/pids.json
.pytest_cache/
*.egg-info/
.DS_Store
site/
.dvc-local-remote/
data/chroma/
data/pid_store/cache/
data/blobs/

# Terraform — state/cache/real-values files, same "never commit the real
# one, .example ships instead" rule as .env. .terraform.lock.hcl is NOT
# ignored — that's a provider version lock file meant to be committed
# (same idea as package-lock.json), unlike everything else here.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars
terraform/*.tfplan
